# SQLite for local dev — for production, point this at a Postgres
# instance instead (Supabase/Railway/Render all give you a connection
# string) and change the provider in prisma/schema.prisma to "postgresql".
DATABASE_URL="file:./dev.db"

# Long random string — used to sign buyer/admin JWTs.
JWT_SECRET="change-this-to-a-long-random-string"

PORT=4000

# Your BaridiMob receiving number, shown to buyers on the payment screen.
BARIDIMOB_NUMBER="00799999 0012 34"
